{
  "name": "cinebook",
  "private": true,
  "version": "0.1.0",
  "description": "CineBook — a BookMyShow-style booking system and an empirical study of concurrency control for seat reservation",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @cinebook/api\" \"npm run dev -w @cinebook/web\"",
    "build": "npm run build -w @cinebook/api && npm run build -w @cinebook/web",
    "start": "npm run build && node scripts/start.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @cinebook/api",
    "db:seed": "npm run db:seed -w @cinebook/api",
    "db:reset": "npm run db:reset -w @cinebook/api",
    "test:e2e": "playwright test",
    "start:only": "node scripts/start.mjs",
    "stats:selftest": "node experiments/harness/stats.mjs",
    "experiments:run": "node experiments/harness/runner.mjs --exp E1,E2,E3 --run main-neon",
    "experiments:platform": "node experiments/harness/runner.mjs --exp E5 --run main-pglite",
    "experiments:live": "node experiments/harness/live.mjs --run main-live",
    "experiments:web": "node experiments/harness/web-benchmark.mjs --run main-web",
    "experiments:ux": "node experiments/harness/ux-funnel.mjs --run main-ux",
    "experiments:scale": "node experiments/harness/live-extended.mjs --only E8 --run main-scale",
    "experiments:reliability": "node experiments/harness/live-extended.mjs --only E9 --run main-reliability",
    "experiments:db": "node experiments/harness/db-optim.mjs --run main-dbopt",
    "experiments:security": "node experiments/harness/security.mjs --run main-security",
    "experiments:recsim": "tsx experiments/harness/recsim.mjs --run main-recsim",
    "experiments:analyze": "node experiments/harness/analyze.mjs --neon main-neon --pglite main-pglite --live main-live && node experiments/harness/analyze-extended.mjs",
    "experiments:figures": "node experiments/harness/charts.mjs",
    "experiments:dashboard": "node experiments/dashboard/server.mjs",
    "report:build": "node experiments/harness/build-report.mjs && node experiments/harness/build-report.mjs --doc literature-review && node experiments/harness/build-docx.mjs && node experiments/harness/build-docx.mjs --doc literature-review"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "docx": "^9.15.0",
    "esbuild": "^0.27.7",
    "jstat": "^1.9.6",
    "marked": "^15.0.12",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
