# --- Database -------------------------------------------------------------
# Neon pooled connection string (use the "-pooler" host). Leave unset for local
# dev: the API then runs on an embedded Postgres (PGlite) in .data/pglite and
# seeds itself with demo data on first boot.
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/cinebook?sslmode=require

# --- Auth -----------------------------------------------------------------
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
CORS_ORIGINS=http://localhost:5173
# COOKIE_SECURE=true   # defaults to true when NODE_ENV=production

# --- TMDB (free key: https://www.themoviedb.org/settings/api) --------------
# Either the v3 "API Key" or the v4 "API Read Access Token" works.
# TMDB_API_KEY=

# --- Seeded admin -----------------------------------------------------------
ADMIN_EMAIL=admin@cinebook.dev
ADMIN_PASSWORD=Admin@12345

# --- Tuning -----------------------------------------------------------------
PORT=4000
HOLD_MINUTES=10
PAYMENT_DELAY_MS=1500
PAYMENT_TIMEOUT_DELAY_MS=20000
SWEEPER_INTERVAL_MS=60000
